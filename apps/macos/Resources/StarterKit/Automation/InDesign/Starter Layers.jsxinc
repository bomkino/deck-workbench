/* pitch.dog / Five starter layers 0.1.0. ES3. No UI and no automatic save.
   Load this include, then call PitchdogStarterLayers.apply(document).
   Native verification should include Normal/Preview, PDF and a TOC update. */
var PitchdogStarterLayers = (function () {
    var NAMES = ['TEXT', 'PSD - CHARACTERS', 'GRADIENT', 'PSD - BACKGROUNDS', 'Solid Background'];
    var RUN_KEY = 'pitchdog.starter.layers.last-run';
    var MAP = {
        'TEXT': 'TEXT', 'Content': 'TEXT', 'Page-Number': 'TEXT',
        'NUMBERS': 'TEXT', '[Guides]': 'TEXT', 'Notes - Nonprinting': 'TEXT', 'TOC Markers - Hidden': 'TEXT',
        'PSD - CHARACTERS': 'PSD - CHARACTERS', 'PSD - Character': 'PSD - CHARACTERS',
        'GRADIENT': 'GRADIENT',
        'PSD - BACKGROUNDS': 'PSD - BACKGROUNDS', 'PSD - Background': 'PSD - BACKGROUNDS', 'Images': 'PSD - BACKGROUNDS',
        'Solid Background': 'Solid Background', 'Background': 'Solid Background'
    };
    function fail(message) { throw new Error(message); }
    function resolved(item) { return item.getElements()[0]; }
    function kind(item) { return item.constructor.name; }
    function key(id) { return 'id' + id; }
    function near(a, b) { for (var i = 0; i < a.length; i++) if (Math.abs(a[i] - b[i]) > 0.001) return false; return a.length === b.length; }
    function list(collection) { return collection.length ? collection.everyItem().getElements() : []; }
    function isMarker(item, layerName) {
        return layerName === 'TOC Markers - Hidden' || (kind(item) === 'TextFrame' && item.appliedObjectStyle.name === 'TOC marker - Nonprinting');
    }
    function itemTarget(item, layerName) {
        var role = item.extractLabel('pitchdog.psd.role');
        if (role === 'character' || item.name === 'Characters - PSD') return NAMES[1];
        if (role === 'background' || item.name === 'Base - PSD') return NAMES[3];
        return MAP[layerName];
    }
    function textSignature(story) {
        var ranges = list(story.textStyleRanges), result = [], i, r, font;
        for (i = 0; i < ranges.length; i++) {
            r = ranges[i]; font = r.appliedFont;
            result.push([r.contents, r.appliedParagraphStyle.id, r.appliedCharacterStyle.id,
                typeof font === 'string' ? font : font.name, String(r.fontStyle), String(r.pointSize), String(r.leading), String(r.tracking)].join('\u0001'));
        }
        return result.join('\u0002');
    }
    function inspect(doc) {
        var state = { layers: [], layerById: {}, layerByName: {}, items: [], itemById: {}, roots: [], guides: [], stories: [], guideVisibility: {}, markers: 0 };
        var layers = list(doc.layers), spreads = list(doc.spreads).concat(list(doc.masterSpreads)), stories = {}, i, j, all, top, item, layer, snap, role, marker, special;
        for (i = 0; i < layers.length; i++) {
            layer = layers[i];
            if (state.layerByName[layer.name]) fail('Two layers are named ' + layer.name + '. Give them unique names before simplifying the starter.');
            if (!MAP[layer.name] && (layer.allPageItems.length || layer.guides.length)) fail('Unknown occupied layer: ' + layer.name + '. Move its objects to an intended role first; nothing has changed.');
            snap = { layer: layer, id: layer.id, name: layer.name, index: i, visible: layer.visible, printable: layer.printable,
                locked: layer.locked, showGuides: layer.showGuides, lockGuides: layer.lockGuides };
            state.layers.push(snap); state.layerById[key(layer.id)] = snap; state.layerByName[layer.name] = snap;
        }
        for (i = 0; i < spreads.length; i++) {
            all = spreads[i].allPageItems;
            for (j = 0; j < all.length; j++) {
                item = resolved(all[j]);
                if (state.itemById[key(item.id)]) continue;
                layer = state.layerById[key(item.itemLayer.id)];
                if (!layer || !MAP[layer.name]) fail('An object uses an unrecognised layer: ' + item.name + '.');
                marker = isMarker(item, layer.name);
                special = marker || layer.name === 'NUMBERS' || layer.name === '[Guides]' || layer.name === 'Notes - Nonprinting';
                role = itemTarget(item, layer.name);
                var depth = 0, container = item.parent;
                while (container && kind(container) !== 'Spread' && kind(container) !== 'MasterSpread' && kind(container) !== 'Document' && depth < 100) { depth++; container = container.parent; }
                snap = { item: item, id: item.id, parentId: item.parent.id, depth: depth, name: item.name, layer: layer, target: role,
                    bounds: item.geometricBounds.slice(0), objectStyleId: item.appliedObjectStyle.id,
                    visible: marker ? true : item.visible && layer.visible,
                    nonprinting: item.nonprinting || !layer.printable || special,
                    locked: item.locked || layer.locked || special, marker: marker };
                state.items.push(snap); state.itemById[key(item.id)] = snap;
                if (marker) state.markers++;
                if (kind(item) === 'TextFrame' && !stories[key(item.parentStory.id)]) {
                    stories[key(item.parentStory.id)] = true;
                    state.stories.push({ story: resolved(item.parentStory), contents: item.parentStory.contents, style: textSignature(item.parentStory) });
                }
            }
            top = list(spreads[i].pageItems);
            for (j = 0; j < top.length; j++) {
                snap = state.itemById[key(top[j].id)];
                if (!snap) fail('Could not inspect a top-level page object.');
                snap.zIndex = j; state.roots.push(snap);
            }
            all = list(spreads[i].guides);
            for (j = 0; j < all.length; j++) {
                item = all[j]; layer = state.layerById[key(item.itemLayer.id)]; role = MAP[layer.name];
                if (!role) fail('A native guide uses an unrecognised layer: ' + layer.name + '.');
                var guideVisible = layer.visible && layer.showGuides;
                if (state.guideVisibility[role] !== undefined && state.guideVisibility[role] !== guideVisible) {
                    fail('Native guides that would share ' + role + ' have different layer visibility settings. Make those guide layers consistently visible or hidden first; individual native guides have no visibility property.');
                }
                state.guideVisibility[role] = guideVisible;
                state.guides.push({ guide: item, id: item.id, parentId: item.parent.id, target: role,
                    location: item.location, orientation: item.orientation, fitToPage: item.fitToPage,
                    threshold: item.viewThreshold, guideType: item.guideType, guideZone: item.guideZone, colour: item.guideColor,
                    locked: item.locked || layer.locked || layer.lockGuides || layer.name === '[Guides]' });
            }
        }
        // Existing groups/anchored objects are retained, never split to manufacture a role.
        for (i = 0; i < state.items.length; i++) {
            snap = state.items[i]; var parent = state.itemById[key(snap.parentId)];
            if (parent && parent.target !== snap.target) fail('The group containing ' + snap.name + ' spans different intended roles. Separate that group deliberately before simplifying the layers.');
        }
        state.items.sort(function (a, b) { return a.depth - b.depth; });
        return state;
    }
    function verify(doc, state, targets) {
        var i, s, x, ids = {}, count = 0, spreads = list(doc.spreads).concat(list(doc.masterSpreads)), all;
        if (doc.layers.length !== NAMES.length) fail('The final document does not have exactly five layers.');
        for (i = 0; i < NAMES.length; i++) if (doc.layers[i].name !== NAMES[i]) fail('The five layers are in the wrong order.');
        for (i = 0; i < state.items.length; i++) {
            s = state.items[i]; x = s.item;
            if (!x.isValid || x.id !== s.id || x.parent.id !== s.parentId || x.name !== s.name ||
                !near(x.geometricBounds, s.bounds) || x.appliedObjectStyle.id !== s.objectStyleId || x.itemLayer.id !== targets[s.target].id ||
                x.visible !== s.visible || x.nonprinting !== s.nonprinting || x.locked !== s.locked) fail('Object preservation failed for ' + s.name + '.');
        }
        for (i = 0; i < state.stories.length; i++) {
            s = state.stories[i];
            if (!s.story.isValid || s.story.contents !== s.contents || textSignature(s.story) !== s.style) fail('Text or text styling changed during layer migration.');
        }
        for (i = 0; i < spreads.length; i++) {
            all = spreads[i].allPageItems;
            for (var j = 0; j < all.length; j++) if (!ids[key(all[j].id)]) { ids[key(all[j].id)] = true; count++; }
        }
        if (count !== state.items.length) fail('The number of page/master objects changed.');
        count = 0;
        for (i = 0; i < spreads.length; i++) count += spreads[i].guides.length;
        if (count !== state.guides.length) fail('The number of native guides changed.');
        for (i = 0; i < state.guides.length; i++) {
            s = state.guides[i]; x = s.guide;
            if (!x.isValid || x.id !== s.id || x.parent.id !== s.parentId || x.itemLayer.id !== targets[s.target].id ||
                Math.abs(x.location - s.location) > 0.001 || x.orientation !== s.orientation || x.fitToPage !== s.fitToPage ||
                x.viewThreshold !== s.threshold || x.guideType !== s.guideType || x.guideZone !== s.guideZone || String(x.guideColor) !== String(s.colour) || x.locked !== s.locked) fail('A native guide changed unexpectedly.');
        }
    }
    function apply(doc) {
        if (!doc || !doc.isValid) fail('Pass an open InDesign document to PitchdogStarterLayers.apply(doc).');
        var units = app.scriptPreferences.measurementUnit, redraw = app.scriptPreferences.enableRedraw, guideLock=doc.guidePreferences.guidesLocked, state, targets = {}, entered = false;
        var run = String(new Date().getTime()) + '-' + String(Math.random()), previous = doc.extractLabel(RUN_KEY), result, phase='inspect';
        try {
            app.scriptPreferences.measurementUnit = MeasurementUnits.POINTS;
            state = inspect(doc);
            app.doScript(function () {
                doc.insertLabel(RUN_KEY, run); entered = true; app.scriptPreferences.enableRedraw = false; doc.guidePreferences.guidesLocked=false;
                var i, s, layer, candidate, root, targetLocks = {}, preferred = {
                    'TEXT': ['TEXT', 'Content'], 'PSD - CHARACTERS': ['PSD - CHARACTERS', 'PSD - Character'],
                    'GRADIENT': ['GRADIENT'], 'PSD - BACKGROUNDS': ['PSD - BACKGROUNDS', 'PSD - Background', 'Images'],
                    'Solid Background': ['Solid Background', 'Background']
                };
                phase='unlock layers';
                for (i = 0; i < state.layers.length; i++) {
                    state.layers[i].layer.locked = false; state.layers[i].layer.lockGuides = false; state.layers[i].layer.visible = true;
                }
                // Unlock containing groups before their children; no object is removed or ungrouped.
                for (i = 0; i < state.roots.length; i++) state.roots[i].item.locked = false;
                for (i = 0; i < state.items.length; i++) { state.items[i].item.locked = false; state.items[i].item.visible = true; }
                for (i = 0; i < NAMES.length; i++) {
                    candidate = null;
                    for (var j = 0; j < preferred[NAMES[i]].length; j++) {
                        if (state.layerByName[preferred[NAMES[i]][j]]) { candidate = state.layerByName[preferred[NAMES[i]][j]]; break; }
                    }
                    layer = candidate ? candidate.layer : doc.layers.add({ name: NAMES[i] });
                    layer.name = NAMES[i]; layer.visible = true; layer.printable = true; layer.locked = false;
                    layer.showGuides = state.guideVisibility[NAMES[i]] === undefined ? true : state.guideVisibility[NAMES[i]];
                    layer.lockGuides = false; targets[NAMES[i]] = layer;
                    targetLocks[NAMES[i]] = candidate ? candidate.locked : NAMES[i] === 'Solid Background';
                }
                // Reassign complete top-level objects. Back-to-front processing retains
                // their previous order within each destination layer and each spread.
                state.roots.sort(function (a, b) { return b.layer.index - a.layer.index || b.zIndex - a.zIndex; });
                for (i = 0; i < state.roots.length; i++) {
                    root = state.roots[i]; phase='move '+root.name+' #'+root.id+' to '+root.target+' (item locked '+root.item.locked+', source locked '+root.item.itemLayer.locked+', target locked '+targets[root.target].locked+')';
                    // A renamed layer already retains its native stacking order.
                    // Reordering its existing items would invert some artwork stacks.
                    if(root.item.itemLayer.id!==targets[root.target].id){root.item.itemLayer=targets[root.target];root.item.bringToFront();}
                }
                for (i = 0; i < state.guides.length; i++) {
                    s = state.guides[i]; phase='move native guide #'+s.id; s.guide.locked = false; s.guide.itemLayer = targets[s.target]; s.guide.guideColor = s.colour; s.guide.locked = s.locked;
                }
                // An old layer is deleted only after all page/master objects and guides left it.
                phase='remove empty old layers';
                for (i = 0; i < state.layers.length; i++) {
                    layer = state.layers[i].layer; var keep = false;
                    for (j = 0; j < NAMES.length; j++) if (layer.id === targets[NAMES[j]].id) keep = true;
                    if (!keep) {
                        if (layer.allPageItems.length || layer.guides.length) fail('Objects remain on ' + state.layers[i].name + '; that layer was not deleted.');
                        layer.remove();
                    }
                }
                phase='order five layers';
                for (i = NAMES.length - 2; i >= 0; i--) targets[NAMES[i]].move(LocationOptions.BEFORE, targets[NAMES[i + 1]]);
                // Restore child state before group locks/visibility. Layer locks are restored last.
                for (i = state.items.length - 1; i >= 0; i--) {
                    s = state.items[i]; s.item.nonprinting = s.nonprinting; s.item.visible = s.visible; s.item.locked = s.locked;
                }
                for (i = 0; i < NAMES.length; i++) targets[NAMES[i]].locked = targetLocks[NAMES[i]];
                doc.guidePreferences.guidesLocked=guideLock;
                doc.activeLayer = targets.TEXT; doc.recompose(); verify(doc, state, targets);
                result = { ok: true, layers: NAMES.slice(0), pageAndMasterObjects: state.items.length,
                    nativeGuides: state.guides.length, textStories: state.stories.length, nonprintingTOCMarkers: state.markers,
                    saved: false, undo: 'Use five pitch.dog starter layers' };
            }, ScriptLanguage.JAVASCRIPT, undefined, UndoModes.ENTIRE_SCRIPT, 'Use five pitch.dog starter layers');
            return result;
        } catch (error) {
            error = new Error((error.message || String(error))+' ['+phase+']');
            if (entered && doc.isValid && doc.extractLabel(RUN_KEY) === run) {
                try {
                    doc.undo();
                    if (doc.extractLabel(RUN_KEY) !== previous) fail('The migration marker did not roll back.');
                    error.message += '\nThe layer change was undone. The document has not been saved.';
                } catch (undoError) { error.message += '\nAutomatic Undo could not be verified: ' + (undoError.message || String(undoError)) + '. Close without saving and reopen your backup.'; }
            }
            throw error;
        } finally {
            if(doc.isValid&&doc.guidePreferences.guidesLocked!==guideLock)doc.guidePreferences.guidesLocked=guideLock;
            app.scriptPreferences.measurementUnit = units; app.scriptPreferences.enableRedraw = redraw;
        }
    }
    return { apply: apply, version: '0.1.0' };
}());
