                    e.targetMark=fileMark(e.target);e.hadOriginal=e.target.exists;e.previous=File(originals.fsName+'/'+e.name);if(e.hadOriginal)copy(e.target,e.previous);
                    if(fileMark(e.target)!==e.targetMark)fail(e.name+' was saved in this project during backup. Close it in Photoshop and run again.');
                }
            }
            for(i=0;i<order.length;i++)if(order[i].incoming){
                e=order[i];if(fileMark(e.target)!==e.targetMark)fail(e.name+' changed before replacement. Close it in Photoshop and run again.');
                promoted.push(e);if(e.target.exists&&!e.target.remove())fail('Cannot replace '+e.name+'. Close it in Photoshop, then run again.');copy(e.stage,e.target);assertPSD(e.target,size);report.files.push(e.name);
            }
            app.doScript(function(){
                doc.insertLabel(runKey,runID);entered=true;
                try {
                for(var z=0;z<locks.length;z++)locks[z].layer.locked=false;for(z=0;z<slots.length;z++)slots[z].frame.locked=false;
                for(z=0;z<slots.length;z++){
                    var slot=slots[z],frame=slot.frame,target=byName[slot.file.toLowerCase()].target;
                    frame.allGraphics[0].itemLink.relink(target);g=frame.allGraphics[0];if(g.itemLink.status!==LinkStatus.NORMAL)g.itemLink.update();
                    g=setRole(frame.allGraphics[0],slot.role);
                    frame.geometricBounds=slot.frameBounds;g.geometricBounds=slot.imageBounds;
                    if(!nearBounds(frame.geometricBounds,slot.frameBounds)||!nearBounds(g.geometricBounds,slot.imageBounds))fail('Position verification failed for '+slot.file+'.');
                    // relink() receives the canonical File directly. macOS can report that
                    // same resource through a symlink (for example /tmp and /private/tmp).
                    var linkedFile=File(g.itemLink.filePath),targetNow=File(target.fsName);
                    if(g.itemLink.status!==LinkStatus.NORMAL||File.decode(g.itemLink.name)!==slot.file||!linkedFile.exists||linkedFile.length!==targetNow.length)fail('Link verification failed for '+slot.file+'.');
                }
                doc.recompose();
                } finally {
                    for(z=0;z<slots.length;z++)slots[z].frame.locked=slots[z].frameLock;for(z=0;z<locks.length;z++)locks[z].layer.locked=locks[z].locked;
                }
            },ScriptLanguage.JAVASCRIPT,undefined,UndoModes.ENTIRE_SCRIPT,'Refresh pitch.dog PSD links');
            doc.save();saved=true;report.status='complete';report.completed=stamp();
            try{write(reportFile,json(report)+'\n');}catch(writeError){report.warning='Deck saved, but the refresh report could not be updated.';}
            return {ok:true,replacedPSDs:promoted.length,refreshedPlacements:slots.length,backup:backup.fsName,document:doc.fullName.fsName,warning:report.warning||''};
        } catch(error) {
            var failure=new Error(error.message||String(error));
            if(!saved){
                var recovery=[];
                for(var p=promoted.length-1;p>=0;p--){var old=promoted[p];try{if(old.target.exists&&!old.target.remove())fail('Cannot remove incomplete replacement');if(old.hadOriginal)copy(old.previous,old.target);}catch(restoreError){recovery.push(old.name+': '+restoreError.message);}}
                if(entered&&doc.extractLabel(runKey)===runID)try{doc.undo();if(doc.extractLabel(runKey)!==previousRun)fail('Refresh transaction was not fully undone.');}catch(undoError){recovery.push('Document Undo: '+undoError.message);}
                if(report){report.status='failed';report.error=failure.message;report.recoveryErrors=recovery;try{write(reportFile,json(report)+'\n');}catch(_){} }
                if(backup)failure.message+='\n\nBackup: '+backup.fsName;
                if(recovery.length)failure.message+='\nRestore from the backup before continuing: '+recovery.join('; ');
            }
            throw failure;
        } finally {
            for(var a=0;a<slots.length;a++)try{if(typeof slots[a].frameLock==='boolean'&&slots[a].frame.locked!==slots[a].frameLock)slots[a].frame.locked=slots[a].frameLock;}catch(_){}
            for(a=0;a<locks.length;a++)try{if(locks[a].layer.locked!==locks[a].locked)locks[a].layer.locked=locks[a].locked;}catch(_){}
            app.scriptPreferences.measurementUnit=oldUnits;app.scriptPreferences.userInteractionLevel=oldUI;
        }
    }
    function chooseRefresh() {
        if(!app.documents.length)fail('Open the generated InDesign deck first.');
        var d=new Window('dialog','Refresh PSD links');d.orientation='column';d.alignChildren='fill';
        d.add('statictext',undefined,'Open deck: '+app.activeDocument.name);
        var current=d.add('radiobutton',undefined,'Refresh files already in this project'),returned=d.add('radiobutton',undefined,'Bring in a returned PSD folder');returned.value=true;
        d.add('statictext',undefined,'Keeps text and image positions. Makes a backup. Saves the deck.');
        var group=d.add('group');group.alignment='right';group.add('button',undefined,'Cancel',{name:'cancel'});group.add('button',undefined,'Continue',{name:'ok'});if(d.show()!==1)return null;
        var folder=null;if(returned.value){folder=Folder.selectDialog('Choose the returned folder containing Slide 01.psd, etc.');if(!folder)return null;}
        return refresh({returnedFolder:folder?folder.fsName:null});
    }
    return {build:build,chooseBuild:chooseBuild,refresh:refresh,chooseRefresh:chooseRefresh,getSlots:getSlots,setRole:setRole,psdHeader:psdHeader,sha256File:sha256File,parseJSON:parseJSON,productionBundle:productionBundle,contentsPlan:contentsPlan,preflightFormatting:preflightFormatting,version:'1.3.0'};
}());
