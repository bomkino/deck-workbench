{
  "name": "deck-workbench",
  "version": "0.0.5",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "generate": "node scripts/generate-bridge.mjs && node scripts/build-kernel.mjs && node scripts/build-workspace.mjs",
    "install:electron": "install-electron",
    "build:linux": "scripts/linux/build-linux-x64.sh",
    "verify:linux": "scripts/linux/verify-packaged-linux.sh",
    "preview:phased": "node prototypes/phased-workbench/serve.mjs",
    "build:phased-preview": "node scripts/build-phased-tracer.mjs",
    "verify:phased-preview": "node scripts/verify-phased-tracer.mjs",
    "test": "npm run generate && node --test tests/*.test.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "verify:repository": "node scripts/verify-repository.mjs",
    "verify": "npm test && npm run verify:source && npm run verify:repository && npm run verify:phased-preview"
  },
  "dependencies": {
    "electron": "44.0.0"
  }
}
