{
  "name": "deck-workbench",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "generate": "node scripts/generate-bridge.mjs && node scripts/build-kernel.mjs",
    "install:electron": "install-electron",
    "build:linux": "scripts/linux/build-linux-x64.sh",
    "verify:linux": "scripts/linux/verify-packaged-linux.sh",
